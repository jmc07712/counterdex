{
  "openapi": "3.1.0",
  "info": {
    "title": "Counterdex API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object",
                  "title": "Response Health"
                }
              }
            }
          }
        }
      }
    },
    "/api/pokemon": {
      "get": {
        "summary": "List Pokémon",
        "description": "Pokémon in Pokédex order, one page at a time, optionally filtered by name, type and form,\nand by whether PokéAPI still lists them.\n\nTo get the next page, pass the response's `next_cursor` as `cursor`, keeping the same\nfilters; it's `null` on the last page. Alternate forms, such as Mega Evolutions and regional\nforms, are numbered from 10001, so they come after the main Pokédex.",
        "operationId": "list_pokemon",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 50
                },
                {
                  "type": "null"
                }
              ],
              "description": "Part of a name, e.g. `char` or `mega x`. Case doesn't matter.",
              "title": "Q"
            },
            "description": "Part of a name, e.g. `char` or `mega x`. Case doesn't matter."
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "$ref": "#/components/schemas/PokemonType"
              },
              "maxItems": 2,
              "description": "Only Pokémon of this type. Repeat it (`type=fire&type=flying`) to require both.",
              "default": [],
              "title": "Type"
            },
            "description": "Only Pokémon of this type. Repeat it (`type=fire&type=flying`) to require both."
          },
          {
            "name": "forms",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/FormFilter",
              "description": "Which forms to list: `all`, only `default` forms, or only `alternate` forms such as Mega Evolutions and regional forms.",
              "default": "all"
            },
            "description": "Which forms to list: `all`, only `default` forms, or only `alternate` forms such as Mega Evolutions and regional forms."
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/ListingStatus",
              "description": "`listed` for the Pokémon PokéAPI lists, or `removed` for the ones it no longer does.",
              "default": "listed"
            },
            "description": "`listed` for the Pokémon PokéAPI lists, or `removed` for the ones it no longer does."
          },
          {
            "name": "changed",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Only Pokémon a sync has changed in the last week: updated, removed or listed again.",
              "default": false,
              "title": "Changed"
            },
            "description": "Only Pokémon a sync has changed in the last week: updated, removed or listed again."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "How many Pokémon per page.",
              "default": 50,
              "title": "Limit"
            },
            "description": "How many Pokémon per page."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 2147483647,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where to continue from: the previous page's `next_cursor`. Leave it out for the first page.",
              "title": "Cursor"
            },
            "description": "Where to continue from: the previous page's `next_cursor`. Leave it out for the first page."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PokemonPage"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pokemon/{pokemon_id}": {
      "get": {
        "summary": "Get a Pokémon",
        "description": "A Pokémon with its species, the species' other forms, and its evolution family.\n\nPokémon that PokéAPI no longer lists can still be fetched: `removed_at` says when they were\nremoved.",
        "operationId": "get_pokemon",
        "parameters": [
          {
            "name": "pokemon_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": 1,
              "description": "The Pokémon's `id`, e.g. 6 or 10034.",
              "title": "Pokemon Id"
            },
            "description": "The Pokémon's `id`, e.g. 6 or 10034."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PokemonDetails"
                }
              }
            }
          },
          "404": {
            "description": "No Pokémon has this id."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/pokemon/{pokemon_id}/changes": {
      "get": {
        "summary": "List a Pokémon's changes",
        "description": "Every change a sync has found to the Pokémon, newest first: updates to its data, and\nPokéAPI removing it or listing it again. A Pokémon is new to the Pokédex without a change.",
        "operationId": "list_pokemon_changes",
        "parameters": [
          {
            "name": "pokemon_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "maximum": 2147483647,
              "minimum": 1,
              "description": "The Pokémon's `id`, e.g. 6 or 10034.",
              "title": "Pokemon Id"
            },
            "description": "The Pokémon's `id`, e.g. 6 or 10034."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PokemonChange"
                  },
                  "title": "Response List Pokemon Changes"
                }
              }
            }
          },
          "404": {
            "description": "No Pokémon has this id."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/sync/status": {
      "get": {
        "summary": "Sync status",
        "description": "When the Pokédex data last came from PokéAPI, and how the most recent sync went.",
        "operationId": "sync_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncOverview"
                }
              }
            }
          }
        }
      }
    },
    "/api/users": {
      "post": {
        "summary": "Sign up",
        "description": "Creates an account and signs in to it: the response sets the session cookie.",
        "operationId": "sign_up",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "409": {
            "description": "Someone already has this username."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/session": {
      "get": {
        "summary": "Get the signed-in user",
        "description": "Who the session cookie signs in.",
        "operationId": "get_current_user",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Sign in first."
          }
        }
      },
      "post": {
        "summary": "Sign in",
        "description": "Starts a session: the response sets the session cookie, which later requests send back.\n\nSessions last 30 days, and using one in its last 15 renews it for another 30.",
        "operationId": "sign_in",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Credentials"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "401": {
            "description": "Wrong username or password."
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Sign out",
        "description": "Ends the session and clears its cookie. Signing out when signed out does nothing.",
        "operationId": "sign_out",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangeKind": {
        "type": "string",
        "enum": [
          "updated",
          "removed",
          "restored"
        ],
        "title": "ChangeKind"
      },
      "Credentials": {
        "properties": {
          "username": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{3,32}$",
            "title": "Username",
            "description": "3 to 32 letters, digits, underscores or hyphens. Case is kept, but ignored when comparing:\n\"Ash\" and \"ash\" are the same user."
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "format": "password",
            "title": "Password",
            "description": "8 to 128 characters.",
            "writeOnly": true
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Credentials",
        "description": "A username and password, for signing up or signing in."
      },
      "EvolutionMethod": {
        "properties": {
          "trigger": {
            "$ref": "#/components/schemas/EvolutionTrigger",
            "description": "What sets the evolution off."
          },
          "min_level": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Level",
            "description": "The level it must reach."
          },
          "item": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Item",
            "description": "The item to use on it."
          },
          "held_item": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Held Item",
            "description": "The item it must hold."
          },
          "known_move": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Known Move",
            "description": "A move it must know."
          },
          "known_move_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PokemonType"
              },
              {
                "type": "null"
              }
            ],
            "description": "It must know a move of this type."
          },
          "used_move": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Used Move",
            "description": "The move it must use."
          },
          "min_move_count": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Move Count",
            "description": "How many times it must use `used_move`."
          },
          "trade_species": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trade Species",
            "description": "The species it must be traded for."
          },
          "party_species": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Party Species",
            "description": "A species that must be in the party."
          },
          "party_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PokemonType"
              },
              {
                "type": "null"
              }
            ],
            "description": "A Pokémon of this type must be in the party."
          },
          "min_happiness": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Happiness",
            "description": "The friendship it must have, at least."
          },
          "min_steps": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Steps",
            "description": "How many steps it must walk, at least."
          },
          "min_damage_taken": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Min Damage Taken",
            "description": "How much damage it must take, at least."
          },
          "relative_physical_stats": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RelativePhysicalStats"
              },
              {
                "type": "null"
              }
            ],
            "description": "How its Attack must compare to its Defense."
          },
          "location": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Location",
            "description": "Where it must be."
          },
          "region": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Region",
            "description": "The region it must be in."
          },
          "time_of_day": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TimeOfDay"
              },
              {
                "type": "null"
              }
            ],
            "description": "When it must be."
          },
          "gender": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Gender"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only Pokémon of this gender evolve this way."
          },
          "needs_overworld_rain": {
            "type": "boolean",
            "title": "Needs Overworld Rain",
            "description": "It must be raining.",
            "default": false
          },
          "needs_multiplayer": {
            "type": "boolean",
            "title": "Needs Multiplayer",
            "description": "It must be with another player.",
            "default": false
          },
          "turn_upside_down": {
            "type": "boolean",
            "title": "Turn Upside Down",
            "description": "The console must be held upside down.",
            "default": false
          },
          "chance": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Chance",
            "description": "The percent chance of evolving this way, when it's left to chance."
          }
        },
        "type": "object",
        "required": [
          "trigger"
        ],
        "title": "EvolutionMethod",
        "description": "One way a species evolves from the one before it in the latest games: what sets it off,\nand any conditions on top. Conditions that don't apply are `null` or `false`. Items, moves,\nspecies and places are named as in PokéAPI, e.g. `thunder-stone`."
      },
      "EvolutionStage": {
        "properties": {
          "species": {
            "$ref": "#/components/schemas/Species"
          },
          "pokemon": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Pokemon"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its default form, or `null` if PokéAPI no longer lists it."
          },
          "methods": {
            "items": {
              "$ref": "#/components/schemas/EvolutionMethod"
            },
            "type": "array",
            "title": "Methods",
            "description": "Each way it evolves from the stage before; none for the first stage."
          },
          "evolves_to": {
            "items": {
              "$ref": "#/components/schemas/EvolutionStage"
            },
            "type": "array",
            "title": "Evolves To",
            "description": "The species it evolves into: more than one where evolution branches."
          }
        },
        "type": "object",
        "required": [
          "species",
          "pokemon",
          "methods",
          "evolves_to"
        ],
        "title": "EvolutionStage",
        "description": "A species in an evolution family: how it evolves from the stage before, and what it\nevolves into."
      },
      "EvolutionTrigger": {
        "type": "string",
        "enum": [
          "level-up",
          "in-battle-level-up",
          "use-item",
          "trade",
          "shed",
          "spin",
          "use-move",
          "agile-style-move",
          "strong-style-move",
          "take-damage",
          "recoil-damage",
          "three-critical-hits",
          "three-defeated-bisharp",
          "tower-of-darkness",
          "tower-of-waters",
          "gimmighoul-coins",
          "meltan-candies",
          "unclassified"
        ],
        "title": "EvolutionTrigger",
        "description": "What sets an evolution off, as PokéAPI names it."
      },
      "FormFilter": {
        "type": "string",
        "enum": [
          "all",
          "default",
          "alternate"
        ],
        "title": "FormFilter",
        "description": "Which forms a list of Pokémon includes."
      },
      "Gender": {
        "type": "string",
        "enum": [
          "female",
          "male"
        ],
        "title": "Gender"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ListingStatus": {
        "type": "string",
        "enum": [
          "listed",
          "removed"
        ],
        "title": "ListingStatus",
        "description": "Whether PokéAPI still lists a Pokémon."
      },
      "Pokemon": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id",
            "description": "Pokédex number. Alternate forms are numbered from 10001."
          },
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Lowercase and hyphenated, e.g. `charizard-mega-x`."
          },
          "types": {
            "items": {
              "$ref": "#/components/schemas/PokemonType"
            },
            "type": "array",
            "maxItems": 2,
            "minItems": 1,
            "title": "Types",
            "description": "One or two types, primary type first."
          },
          "stats": {
            "$ref": "#/components/schemas/Stats"
          },
          "sprite_url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sprite Url",
            "description": "Front-facing sprite image, or `null` if there isn't one."
          },
          "is_default": {
            "type": "boolean",
            "title": "Is Default",
            "description": "`false` for alternate forms, such as Mega Evolutions and regional forms."
          },
          "form": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/PokemonForm"
              },
              {
                "type": "null"
              }
            ],
            "description": "The kind of alternate form, such as `mega` or `alolan`; `null` for a default form."
          },
          "changed_recently": {
            "type": "boolean",
            "title": "Changed Recently",
            "description": "Whether a sync changed it in the last week: updated it, removed it or listed it again.",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "types",
          "stats",
          "sprite_url",
          "is_default"
        ],
        "title": "Pokemon",
        "description": "A Pokémon: its Pokédex number, name, types, base stats and sprite."
      },
      "PokemonChange": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ChangeKind"
          },
          "detected_at": {
            "type": "string",
            "format": "date-time",
            "title": "Detected At",
            "description": "When the sync that found it started."
          },
          "before": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Pokemon"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Pokémon before the change."
          },
          "after": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Pokemon"
              },
              {
                "type": "null"
              }
            ],
            "description": "The Pokémon after the change, or `null` if it was removed."
          }
        },
        "type": "object",
        "required": [
          "kind",
          "detected_at",
          "before",
          "after"
        ],
        "title": "PokemonChange",
        "description": "A change a sync found to a Pokémon, with the Pokémon as it was before and after."
      },
      "PokemonDetails": {
        "properties": {
          "pokemon": {
            "$ref": "#/components/schemas/Pokemon"
          },
          "removed_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Removed At",
            "description": "When PokéAPI stopped listing it, or `null` while it's listed."
          },
          "species": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Species"
              },
              {
                "type": "null"
              }
            ],
            "description": "Its species, or `null` until a sync has stored it."
          },
          "forms": {
            "items": {
              "$ref": "#/components/schemas/Pokemon"
            },
            "type": "array",
            "title": "Forms",
            "description": "Every form of its species that PokéAPI lists, this one included, in Pokédex order."
          },
          "evolution": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/EvolutionStage"
              },
              {
                "type": "null"
              }
