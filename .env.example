# Copy to .env (next to this file) for local development; matches docker-compose.yml.
# `vercel dev` loads it for every service. Backend commands run from backend/ pass it explicitly:
#   uv run --env-file ../.env python -m app.jobs.sync_pokemon
DATABASE_URL=postgresql+psycopg://counterdex:counterdex@localhost:5432/counterdex
# Production (Neon) also sets DATABASE_URL_UNPOOLED, a direct connection that migrations use;
# locally there's no pooler, so migrations use DATABASE_URL.
# Browsers and the CDN may keep the API's public responses; locally data changes by hand, so
# don't let them, or a change can take minutes to show.
CACHE_RESPONSES=false
# Production's session cookie is Secure with a __Host- name, which Chrome and Safari refuse over
# plain http://localhost; locally it's a plain cookie named `session`.
SECURE_COOKIES=false
